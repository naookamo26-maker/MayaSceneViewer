//Maya ASCII 2027 scene
//Name: curve_ops_sample.ma
requires maya "2027";
currentUnit -l centimeter -a degree -t film;
createNode transform -n "src";
createNode nurbsCurve -n "srcShape" -p "src";
	setAttr ".cc" -type "nurbsCurve" 3 4 0 no 3 9 0 0 0 1 2 3 4 4 4 7 0 0 0 1 2 0 2 -1 1 3 3 0 4 0 -1 5 2 0 6 0 0;
createNode transform -n "rb";
createNode nurbsCurve -n "rbShape" -p "rb";
createNode rebuildCurve -n "rb_rebuild";
	setAttr ".s" 8;
	setAttr ".kr" 0;
	setAttr ".end" 1;
createNode transform -n "rv";
createNode nurbsCurve -n "rvShape" -p "rv";
createNode reverseCurve -n "rv_reverse";
createNode transform -n "dt0";
createNode nurbsCurve -n "dt0Shape" -p "dt0";
createNode transform -n "dt2";
createNode nurbsCurve -n "dt2Shape" -p "dt2";
createNode detachCurve -n "dt_detach";
	setAttr -s 2 ".p[0:1]" 1.5 2.5;
	setAttr -s 3 ".k[0:2]" yes no yes;
createNode transform -n "sc";
createNode nurbsCurve -n "scShape" -p "sc";
createNode subCurve -n "sc_sub";
	setAttr ".min" 1;
	setAttr ".max" 3;
createNode joint -n "sp_0";
	setAttr ".t" -type "double3" 0 0 0 ;
createNode joint -n "sp_1" -p "sp_0";
	setAttr ".t" -type "double3" 1 0 0 ;
createNode joint -n "sp_2" -p "sp_1";
	setAttr ".t" -type "double3" 1 0 0 ;
createNode joint -n "sp_3" -p "sp_2";
	setAttr ".t" -type "double3" 1 0 0 ;
createNode joint -n "sp_4" -p "sp_3";
	setAttr ".t" -type "double3" 1 0 0 ;
createNode ikEffector -n "sp_eff" -p "sp_3";
	setAttr ".t" -type "double3" 1 0 0 ;
createNode ikHandle -n "sp_ik";
	setAttr ".roc" yes;
createNode ikSplineSolver -n "ikSplineSolver";
createNode transform -n "dynSrc";
createNode nurbsCurve -n "dynSrcShape" -p "dynSrc";
	setAttr ".cc" -type "nurbsCurve" 3 4 0 no 3 9 0 0 0 1 2 3 4 4 4 7 0 0 0 1 2 0 2 -1 1 3 3 0 4 0 -1 5 2 0 6 0 0;
createNode transform -n "loc";
	setAttr ".t" -type "double3" 6 0 0 ;
createNode locator -n "locShape" -p "loc";
createNode transform -n "dyn";
createNode nurbsCurve -n "dynShape" -p "dyn";
createNode rebuildCurve -n "dyn_rebuild";
	setAttr ".s" 6;
	setAttr ".end" 1;
createNode transform -n "probe";
	setAttr ".ty" 3;
createNode joint -n "nj";
createNode joint -n "nj2";
createNode nearestPointOnCurve -n "npc";
createNode animCurveTL -n "loc_translateY";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 24 3;
createNode animCurveTL -n "probe_translateX";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 24 6;
createNode script -n "sceneConfigurationScriptNode";
	setAttr ".b" -type "string" "playbackOptions -min 1 -max 24 -ast 1 -aet 24 ";
	setAttr ".st" 6;
connectAttr "loc_translateY.o" "loc.ty";
connectAttr "probe_translateX.o" "probe.tx";
connectAttr "srcShape.l" "rb_rebuild.ic";
connectAttr "rb_rebuild.oc" "rbShape.cr";
connectAttr "srcShape.l" "rv_reverse.ic";
connectAttr "rv_reverse.oc" "rvShape.cr";
connectAttr "srcShape.l" "dt_detach.ic";
connectAttr "dt_detach.oc[0]" "dt0Shape.cr";
connectAttr "dt_detach.oc[2]" "dt2Shape.cr";
connectAttr "srcShape.l" "sc_sub.ic";
connectAttr "sc_sub.oc" "scShape.cr";
connectAttr "sp_0.msg" "sp_ik.hsj";
connectAttr "sp_eff.hp" "sp_ik.hee";
connectAttr "ikSplineSolver.msg" "sp_ik.hsv";
connectAttr "sp_4.tx" "sp_eff.tx";
connectAttr "sp_4.ty" "sp_eff.ty";
connectAttr "sp_4.tz" "sp_eff.tz";
connectAttr "rbShape.ws" "sp_ik.ic";
connectAttr "locShape.wp" "dynSrcShape.cp[6]";
connectAttr "dynSrcShape.ws" "dyn_rebuild.ic";
connectAttr "dyn_rebuild.oc" "dynShape.cr";
connectAttr "srcShape.ws" "npc.ic";
connectAttr "probe.t" "npc.ip";
connectAttr "npc.p" "nj.t";
connectAttr "npc.pr" "nj2.tx";
// End of curve_ops_sample.ma
