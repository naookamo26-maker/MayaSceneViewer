connectAttr "j1_pc.cry" "j1.ry";
connectAttr "j1_pc.ctz" "j1.tz";
connectAttr "j1_pc.crz" "j1.rz";
connectAttr "j2_pc.w0" "j2_pc.tg[0].tw";
connectAttr "jt.t" "j2_pc.tg[0].tt";
connectAttr "jt.rp" "j2_pc.tg[0].trp";
connectAttr "jt.rpt" "j2_pc.tg[0].trt";
