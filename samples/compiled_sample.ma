connectAttr "s3.pm" "j1_pc.tg[1].tpm";
connectAttr "j1.pim" "j1_pc.cpim";
connectAttr "j1.rp" "j1_pc.crp";
connectAttr "j1.rpt" "j1_pc.crt";
connectAttr "j1.ro" "j1_pc.cro";
