connectAttr "j0_pc.ctz" "j0.tz";
connectAttr "j0_pc.crz" "j0.rz";
connectAttr "j0.s" "j1.is";
connectAttr "j1_pc.w0" "j1_pc.tg[0].tw";
connectAttr "c1.t" "j1_pc.tg[0].tt";
connectAttr "c1.rp" "j1_pc.tg[0].trp";
connectAttr "c1.rpt" "j1_pc.tg[0].trt";
connectAttr "c1.r" "j1_pc.tg[0].tr";
connectAttr "c1.ro" "j1_pc.tg[0].tro";
connectAttr "c1.s" "j1_pc.tg[0].ts";
connectAttr "c1.pm" "j1_pc.tg[0].tpm";
connectAttr "c1.jo" "j1_pc.tg[0].tjo";
connectAttr "c1.ssc" "j1_pc.tg[0].tsc";
connectAttr "c1.is" "j1_pc.tg[0].tis";
connectAttr "j1_pc.w1" "j1_pc.tg[1].tw";
connectAttr "s3.t" "j1_pc.tg[1].tt";
connectAttr "s3.rp" "j1_pc.tg[1].trp";
