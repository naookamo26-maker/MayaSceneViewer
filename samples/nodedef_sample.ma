//Maya ASCII 2024 scene
//Name: nodedef_sample.ma
requires maya "2024";
requires "nodeDefSamplePlugin" "1.1";
currentUnit -l centimeter -a degree -t film;
createNode transform -n "ctrl";
createNode transform -n "locA";
createNode locator -n "locAShape" -p "locA";
createNode transform -n "locB";
	setAttr ".t" -type "double3" 4 0 0 ;
createNode locator -n "locBShape" -p "locB";
createNode joint -n "jA";
	setAttr ".t" -type "double3" 0 4 0.1996668332936563 ;
createNode joint -n "jB";
	setAttr ".t" -type "double3" 3 0 -5 ;
createNode joint -n "jC";
	setAttr ".t" -type "double3" 3 0 -10 ;
createNode joint -n "jD";
	setAttr ".t" -type "double3" 0 0 -15 ;
createNode joint -n "jE";
	setAttr ".t" -type "double3" 0 0 -20 ;
createNode weightedSum -n "ws1";
	setAttr ".in[1]" 2;
	setAttr ".in[3]" 1;
	setAttr ".w[0]" 0.5;
	setAttr ".w[3]" 2;
createNode matrixBlend -n "mb1";
	setAttr ".tg[1].tw" 3;
createNode angleDouble -n "ad1";
	setAttr ".of" 10;
createNode waveNode -n "wv1";
createNode divider -n "dv1";
createNode brokenNode -n "bk1";
createNode animCurveTL -n "ctrl_translateX";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 24 10;
createNode animCurveTA -n "ctrl_rotateZ";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 24 90;
createNode script -n "sceneConfigurationScriptNode";
	setAttr ".b" -type "string" "playbackOptions -min 1 -max 24 -ast 1 -aet 24 ";
	setAttr ".st" 6;
connectAttr "ctrl_translateX.o" "ctrl.tx";
connectAttr "ctrl_rotateZ.o" "ctrl.rz";
connectAttr "ctrl.tx" "ws1.input[0]";
connectAttr "ws1.o" "jA.ty";
connectAttr "ctrl.tx" "locA.tx";
connectAttr "locA.wm" "mb1.tg[0].tm";
connectAttr "locB.wm" "mb1.target[1].targetMatrix";
connectAttr "mb1.ot" "jB.t";
connectAttr "mb1.otx" "jC.tx";
connectAttr "ctrl.rz" "ad1.ia";
connectAttr "ad1.oa" "jD.rx";
connectAttr "wv1.o" "jA.tz";
connectAttr "dv1.o" "jE.tz";
connectAttr "bk1.o" "jE.ty";
// End of nodedef_sample.ma
