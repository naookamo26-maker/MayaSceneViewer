	setAttr ".t" -type "double3" 29.1547536412 0.0184423622196 -1 ;
	setAttr ".ra" -type "double3" 0 0 0 ;
	setAttr ".jo" -type "double3" 0 -0 -4.1347210859e-14 ;
createNode hikFKJoint -n "Character1_Ctrl_LeftHand" -p "Character1_Ctrl_LeftForeArm";
