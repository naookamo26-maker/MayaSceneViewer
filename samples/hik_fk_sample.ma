createNode HIKCharacterNode -n "Character1";
	setAttr ".OutputCharacterDefinition" -type "HIKCharacter" ;
	setAttr ".InputCharacterizationLock" yes;
	setAttr ".HipsTy" 100;
	setAttr ".HipsRx" 90;
	setAttr ".HipsRz" 90;
	setAttr ".SpineTy" 110;
	setAttr ".SpineTz" 1;
