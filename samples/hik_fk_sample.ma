createNode hikFKJoint -n "Character1_Ctrl_Hips" -p "Character1_Ctrl_Reference";
	setAttr ".t" -type "double3" 0 100 0 ;
	setAttr ".ra" -type "double3" 0 0 0 ;
	setAttr ".jo" -type "double3" 0 -0 0 ;
