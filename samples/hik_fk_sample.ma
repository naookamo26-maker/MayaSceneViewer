createNode joint -n "LeftArm" -p "ShoulderExtra";
	addAttr -s false -ci true -sn "ch" -ln "Character" -at "message";
	setAttr ".ra" -type "double3" 0 15 0 ;
	setAttr ".jo" -type "double3" 1.60433894498 -14.9159146797 -49.2100311919 ;
	setAttr ".ro" 3;
	setAttr ".bps" -type "matrix" 0.857167300702 -0.51503807491 0 0 0.51503807491 0.857167300702 0 0 0 0 1 0 15 140 0 1 ;
