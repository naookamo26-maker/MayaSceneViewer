	rename -uid "00000000-0000-0000-0007-002123194911";
	setAttr ".ip[0].gtg" -type "string" "fin_k3";
createNode transform -n "fin_k4Handle";
	rename -uid "00000000-0000-0000-0007-000061187262";
createNode clusterHandle -n "fin_k4HandleShape" -p "fin_k4Handle";
	rename -uid "00000000-0000-0000-0007-002240881843";
createNode cluster -n "fin_k4";
	rename -uid "00000000-0000-0000-0007-003773429692";
	setAttr ".ip[0].gtg" -type "string" "fin_k4";
createNode animCurveTL -n "fin_k4Handle_translateY";
	rename -uid "00000000-0000-0000-0007-003760667959";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 48 3;
createNode animCurveTL -n "fin_k3Handle_translateY";
	rename -uid "00000000-0000-0000-0007-000017381203";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 48 1.5;
createNode transform -n "fin_allCrv";
	rename -uid "00000000-0000-0000-0007-003882283653";
createNode nurbsCurve -n "fin_allShape" -p "fin_allCrv";
	rename -uid "00000000-0000-0000-0007-000005534474";
createNode nurbsCurve -n "fin_allShapeOrig" -p "fin_allCrv";
	rename -uid "00000000-0000-0000-0007-000896704865";
	setAttr ".io" yes;
	setAttr ".gtag[0].gtagnm" -type "string" "fin_all";
	setAttr ".gtag[0].gtagcmp" -type "componentList" 1 "cv[*]";
	setAttr ".cc" -type "nurbsCurve" 3 1 0 no 3 6 0 0 0 1 1 1 4 0 0 -5 2.66666667 0 -5 5.33333333 0 -5 8 0 -5 "gtag" 1 "fin_all" 1 "cv[*]";
createNode transform -n "fin_allHandle";
	rename -uid "00000000-0000-0000-0007-004185978797";
createNode clusterHandle -n "fin_allHandleShape" -p "fin_allHandle";
	rename -uid "00000000-0000-0000-0007-002881283217";
createNode cluster -n "fin_all";
	rename -uid "00000000-0000-0000-0007-000734299684";
	setAttr ".ip[0].gtg" -type "string" "*";
createNode animCurveTL -n "fin_allHandle_translateY";
	rename -uid "00000000-0000-0000-0007-000601714136";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 48 2;
createNode transform -n "fin_lead";
	rename -uid "00000000-0000-0000-0007-003974166404";
	setAttr ".t" -type "double3" 1 0 0 ;
	setAttr ".rp" -type "double3" 6 0 0 ;
	setAttr ".sp" -type "double3" 6 0 0 ;
createNode transform -n "fin_follow";
	rename -uid "00000000-0000-0000-0007-000112846266";
	setAttr ".t" -type "double3" 3 0 0 ;
	setAttr ".rp" -type "double3" 4 0 0 ;
	setAttr ".sp" -type "double3" 4 0 0 ;
createNode joint -n "fin_followJnt" -p "fin_follow";
	rename -uid "00000000-0000-0000-0007-001999066441";
createNode parentConstraint -n "fin_follow_pc" -p "fin_follow";
	rename -uid "00000000-0000-0000-0007-000978882250";
	addAttr -dcb 0 -ci true -k true -sn "w0" -ln "fin_leadW0" -dv 1 -min 0 -at "double";
	setAttr -k on ".nds";
	setAttr -k on ".w0";
createNode animCurveTL -n "fin_lead_translateY";
	rename -uid "00000000-0000-0000-0007-003056886369";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 48 2;
createNode script -n "sceneConfigurationScriptNode";
	rename -uid "00000000-0000-0000-0007-000086746734";
	setAttr ".b" -type "string" "playbackOptions -min 1 -max 48 -ast 1 -aet 48 ";
createNode ikSplineSolver -n "ikSplineSolver";
	rename -uid "00000000-0000-0000-0007-002655845880";
select -ne :time1;
	setAttr ".o" 1;
connectAttr "fin_0.msg" "fin_ik.hsj";
connectAttr "fin_eff.hp" "fin_ik.hee";
connectAttr "ikSplineSolver.msg" "fin_ik.hsv";
connectAttr "fin_4.tx" "fin_eff.tx";
connectAttr "fin_4.ty" "fin_eff.ty";
connectAttr "fin_4.tz" "fin_eff.tz";
connectAttr "fin_slaveShape.ws" "fin_ik.ic";
