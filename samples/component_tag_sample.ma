//Maya ASCII 2024 scene
//Name: component_tag_sample.ma
//Codeset: UTF-8
requires maya "2024";
currentUnit -l centimeter -a degree -t film;
fileInfo "application" "maya";
createNode joint -n "fin_0";
	rename -uid "00000000-0000-0000-0007-003486341732";
	setAttr ".t" -type "double3" 0 0 5 ;
createNode joint -n "fin_1" -p "fin_0";
	rename -uid "00000000-0000-0000-0007-003100273394";
	setAttr ".t" -type "double3" 2 0 0 ;
createNode joint -n "fin_2" -p "fin_1";
	rename -uid "00000000-0000-0000-0007-000566442824";
	setAttr ".t" -type "double3" 2 0 0 ;
createNode joint -n "fin_3" -p "fin_2";
	rename -uid "00000000-0000-0000-0007-001455688670";
	setAttr ".t" -type "double3" 2 0 0 ;
createNode joint -n "fin_4" -p "fin_3";
	rename -uid "00000000-0000-0000-0007-003365969533";
	setAttr ".t" -type "double3" 2 0 0 ;
createNode ikEffector -n "fin_eff" -p "fin_3";
	rename -uid "00000000-0000-0000-0007-000922169196";
	setAttr ".t" -type "double3" 2 0 0 ;
	setAttr ".v" no;
createNode ikHandle -n "fin_ik";
	rename -uid "00000000-0000-0000-0007-000688642395";
	setAttr ".roc" yes;
createNode transform -n "fin_slave";
	rename -uid "00000000-0000-0000-0007-003803177630";
	setAttr ".it" no;
createNode nurbsCurve -n "fin_slaveShape" -p "fin_slave";
	rename -uid "00000000-0000-0000-0007-002967292717";
createNode nurbsCurve -n "fin_slaveShapeOrig" -p "fin_slave";
	rename -uid "00000000-0000-0000-0007-000063902272";
	setAttr ".io" yes;
	setAttr ".cc" -type "nurbsCurve" 3 1 0 no 3 6 0 0 0 1 1 1 4 0 0 5 2.66666667 0 5 5.33333333 0 5 8 0 5;
createNode transform -n "fin_drv";
	rename -uid "00000000-0000-0000-0007-000070025834";
createNode nurbsCurve -n "fin_drvShape" -p "fin_drv";
	rename -uid "00000000-0000-0000-0007-003709385472";
createNode nurbsCurve -n "fin_drvShapeOrig" -p "fin_drv";
	rename -uid "00000000-0000-0000-0007-001641883805";
	setAttr ".io" yes;
	setAttr ".gtag[0].gtagnm" -type "string" "fin_k1";
	setAttr ".gtag[0].gtagcmp" -type "componentList" 1 "cv[0]";
	setAttr ".gtag[1].gtagnm" -type "string" "fin_k2";
	setAttr ".gtag[1].gtagcmp" -type "componentList" 1 "cv[1]";
	setAttr ".gtag[2].gtagnm" -type "string" "fin_k3";
	setAttr ".gtag[2].gtagcmp" -type "componentList" 1 "cv[2]";
	setAttr ".gtag[3].gtagnm" -type "string" "fin_k4";
	setAttr ".gtag[3].gtagcmp" -type "componentList" 1 "cv[3]";
	setAttr ".cc" -type "nurbsCurve" 3 1 0 no 3 6 0 0 0 1 1 1 4 0 0 5 2.66666667 0 5 5.33333333 0 5 8 0 5 "gtag" 4 "fin_k1" 1 "cv[0]" "fin_k2" 1 "cv[1]" "fin_k3" 1 "cv[2]" "fin_k4" 1 "cv[3]";
createNode transform -n "fin_base";
	rename -uid "00000000-0000-0000-0007-000080046126";
	setAttr ".v" no;
createNode nurbsCurve -n "fin_baseShape" -p "fin_base";
	rename -uid "00000000-0000-0000-0007-001872367610";
	setAttr ".cc" -type "nurbsCurve" 3 1 0 no 3 6 0 0 0 1 1 1 4 0 0 5 2.66666667 0 5 5.33333333 0 5 8 0 5;
createNode wire -n "fin_wire";
	rename -uid "00000000-0000-0000-0007-001946857338";
	setAttr ".dds[0]" 20;
	setAttr ".ip[0].gtg" -type "string" "*";
createNode transform -n "fin_k1Handle";
	rename -uid "00000000-0000-0000-0007-001369279257";
createNode clusterHandle -n "fin_k1HandleShape" -p "fin_k1Handle";
	rename -uid "00000000-0000-0000-0007-000489837475";
createNode cluster -n "fin_k1";
	rename -uid "00000000-0000-0000-0007-002424505139";
	setAttr ".ip[0].gtg" -type "string" "fin_k1";
createNode transform -n "fin_k2Handle";
	rename -uid "00000000-0000-0000-0007-001618317700";
createNode clusterHandle -n "fin_k2HandleShape" -p "fin_k2Handle";
	rename -uid "00000000-0000-0000-0007-001789690195";
createNode cluster -n "fin_k2";
	rename -uid "00000000-0000-0000-0007-000160060041";
	setAttr ".ip[0].gtg" -type "string" "fin_k2";
createNode transform -n "fin_k3Handle";
	rename -uid "00000000-0000-0000-0007-003322059312";
createNode clusterHandle -n "fin_k3HandleShape" -p "fin_k3Handle";
	rename -uid "00000000-0000-0000-0007-004043951420";
