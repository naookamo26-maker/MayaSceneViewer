connectAttr "ctl.ty" "u_choice.i[1]";
connectAttr "u_choice.o" "u_jnt5.tz";
connectAttr "roll_ctrl_roll.o" "roll_ctrl.roll";
connectAttr "roll_ctrl.roll" "roll_jnt_rotateZ.i";
