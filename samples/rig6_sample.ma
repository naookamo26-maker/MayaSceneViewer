connectAttr "ctl.ty" "u_clamp.ipg";
connectAttr "u_clamp.opg" "u_jnt2.ty";
connectAttr "ctl.tz" "u_clamp.ipb";
connectAttr "u_clamp.opb" "u_jnt2.tz";
connectAttr "ctl.tx" "u_remap.i";
