//Maya ASCII 2024 scene
//Name: plugin_convert_sample.ma
requires maya "2024";
requires "sampleRigNodes" "1.2";
requires "sampleRigNodesApi1" "0.9";
currentUnit -l centimeter -a degree -t film;
createNode transform -n "ctrl";
createNode transform -n "locA";
createNode locator -n "locAShape" -p "locA";
createNode transform -n "locB";
	setAttr ".t" -type "double3" 4 0 0 ;
createNode locator -n "locBShape" -p "locB";
createNode transform -n "locC";
	setAttr ".t" -type "double3" 0 5 10 ;
createNode locator -n "locCShape" -p "locC";
createNode joint -n "jA";
createNode joint -n "jB";
createNode joint -n "jC";
createNode joint -n "jD";
createNode joint -n "jE";
createNode joint -n "jF";
createNode joint -n "jG";
createNode joint -n "jH";
createNode weightedSumNode -n "ws";
	setAttr ".in[2]" 3;
	setAttr ".w[0]" 0.5;
	setAttr ".w[2]" 2;
createNode targetAverage -n "ta";
	setAttr ".tg[1].tw" 3;
createNode angleScale -n "an";
	setAttr ".oa" 10;
createNode aimMatrix2 -n "am";
createNode decomposeMatrix -n "dm";
createNode stretchArray -n "sa";
	setAttr ".iv[1]" 5;
	setAttr ".st" 3;
createNode legacySum -n "ls";
	setAttr ".vals[1]" 2;
	setAttr ".gn" 0.5;
createNode vectorLength -n "vl";
	setAttr ".iv" -type "double3" 0 3 4 ;
createNode animCurveTL -n "ctrl_translateX";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 24 10;
createNode animCurveTA -n "ctrl_rotateZ";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 24 90;
createNode script -n "sceneConfigurationScriptNode";
	setAttr ".b" -type "string" "playbackOptions -min 1 -max 24 -ast 1 -aet 24 ";
	setAttr ".st" 6;
connectAttr "ctrl_translateX.o" "ctrl.tx";
connectAttr "ctrl_rotateZ.o" "ctrl.rz";
connectAttr "ctrl.tx" "locA.tx";
connectAttr "ctrl.tx" "ws.input[0]";
connectAttr "ws.o" "jA.ty";
connectAttr "locA.wm" "ta.tg[0].tm";
connectAttr "locB.wm" "ta.target[1].targetMatrix";
connectAttr "ta.ot" "jB.t";
connectAttr "ta.otX" "jC.tx";
connectAttr "ctrl.rz" "an.ia";
connectAttr "an.out" "jD.rx";
connectAttr "locA.wm" "am.bm";
connectAttr "locC.wm" "am.tgm";
connectAttr "am.om" "dm.imat";
connectAttr "dm.ot" "jF.t";
connectAttr "dm.or" "jF.r";
connectAttr "ctrl.tx" "sa.iv[0]";
connectAttr "sa.ov[0]" "jE.tx";
connectAttr "sa.ov[1]" "jE.ty";
connectAttr "ctrl.tx" "ls.vals[0]";
connectAttr "ls.res" "jG.tx";
connectAttr "ctrl.tx" "vl.ivx";
connectAttr "vl.len" "jG.ty";
connectAttr "vl.nrm" "jH.t";
// End of plugin_convert_sample.ma
