createNode ikSCsolver -n "ikSCsolver";
	rename -uid "00000000-0000-0000-0004-002950532908";
createNode ikSplineSolver -n "ikSplineSolver";
	rename -uid "00000000-0000-0000-0004-002655845880";
select -ne :time1;
