//Maya ASCII 2024 scene
//Name: place2d_sample.ma
requires maya "2024";
requires "exprespy" "3.0.1.20220627";
currentUnit -l centimeter -a degree -t film;
createNode joint -n "texJ";
createNode transform -n "q1";
	setAttr ".t" -type "double3" 0 0 0 ;
createNode mesh -n "q1Shape" -p "q1";
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 4 ".uvst[0].uvsp[0:3]" -type "float2" 0 0 1 0 1 1 0 1;
	setAttr ".cuvs" -type "string" "map1";
	setAttr -s 4 ".vt[0:3]"  -1 -1 0 1 -1 0 1 1 0 -1 1 0;
	setAttr -s 4 ".ed[0:3]"  0 1 0 1 2 0 2 3 0 3 0 0;
	setAttr -s 1 -ch 4 ".fc[0:0]" -type "polyFaces" 
		f 4 0 1 2 3
		mu 0 4 0 1 2 3;
createNode lambert -n "m1";
createNode shadingEngine -n "m1SG";
	setAttr ".ro" yes;
createNode file -n "f1";
	setAttr ".ftn" -type "string" "sourceimages/props/quad_D.tga";
createNode place2dTexture -n "p1";
createNode transform -n "q2";
	setAttr ".t" -type "double3" 3 0 0 ;
createNode mesh -n "q2Shape" -p "q2";
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 4 ".uvst[0].uvsp[0:3]" -type "float2" 0 0 1 0 1 1 0 1;
	setAttr ".cuvs" -type "string" "map1";
	setAttr -s 4 ".vt[0:3]"  -1 -1 0 1 -1 0 1 1 0 -1 1 0;
	setAttr -s 4 ".ed[0:3]"  0 1 0 1 2 0 2 3 0 3 0 0;
	setAttr -s 1 -ch 4 ".fc[0:0]" -type "polyFaces" 
		f 4 0 1 2 3
		mu 0 4 0 1 2 3;
createNode lambert -n "m2";
createNode shadingEngine -n "m2SG";
	setAttr ".ro" yes;
createNode file -n "f2";
	setAttr ".ftn" -type "string" "sourceimages/props/quad_D.tga";
createNode place2dTexture -n "p2";
createNode transform -n "q3";
	setAttr ".t" -type "double3" 6 0 0 ;
createNode mesh -n "q3Shape" -p "q3";
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 4 ".uvst[0].uvsp[0:3]" -type "float2" 0 0 1 0 1 1 0 1;
	setAttr ".cuvs" -type "string" "map1";
	setAttr -s 4 ".vt[0:3]"  -1 -1 0 1 -1 0 1 1 0 -1 1 0;
	setAttr -s 4 ".ed[0:3]"  0 1 0 1 2 0 2 3 0 3 0 0;
	setAttr -s 1 -ch 4 ".fc[0:0]" -type "polyFaces" 
		f 4 0 1 2 3
		mu 0 4 0 1 2 3;
createNode lambert -n "m3";
createNode shadingEngine -n "m3SG";
	setAttr ".ro" yes;
createNode file -n "f3";
	setAttr ".ftn" -type "string" "sourceimages/props/quad_D.tga";
createNode place2dTexture -n "p3";
createNode transform -n "q4";
	setAttr ".t" -type "double3" 9 0 0 ;
createNode mesh -n "q4Shape" -p "q4";
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 4 ".uvst[0].uvsp[0:3]" -type "float2" 0 0 1 0 1 1 0 1;
	setAttr ".cuvs" -type "string" "map1";
	setAttr -s 4 ".vt[0:3]"  -1 -1 0 1 -1 0 1 1 0 -1 1 0;
	setAttr -s 4 ".ed[0:3]"  0 1 0 1 2 0 2 3 0 3 0 0;
	setAttr -s 1 -ch 4 ".fc[0:0]" -type "polyFaces" 
		f 4 0 1 2 3
		mu 0 4 0 1 2 3;
createNode lambert -n "m4";
createNode shadingEngine -n "m4SG";
	setAttr ".ro" yes;
createNode file -n "f4";
	setAttr ".ftn" -type "string" "sourceimages/props/quad_D.tga";
createNode place2dTexture -n "p4";
createNode transform -n "q5";
	setAttr ".t" -type "double3" 12 0 0 ;
createNode mesh -n "q5Shape" -p "q5";
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr -s 4 ".uvst[0].uvsp[0:3]" -type "float2" 0 0 1 0 1 1 0 1;
	setAttr ".cuvs" -type "string" "map1";
	setAttr -s 4 ".vt[0:3]"  -1 -1 0 1 -1 0 1 1 0 -1 1 0;
	setAttr -s 4 ".ed[0:3]"  0 1 0 1 2 0 2 3 0 3 0 0;
	setAttr -s 1 -ch 4 ".fc[0:0]" -type "polyFaces" 
		f 4 0 1 2 3
		mu 0 4 0 1 2 3;
createNode lambert -n "m5";
createNode shadingEngine -n "m5SG";
	setAttr ".ro" yes;
createNode file -n "f5";
	setAttr ".ftn" -type "string" "sourceimages/props/quad_D.tga";
createNode place2dTexture -n "p5";
	setAttr ".ro" 30;
	setAttr ".of" -type "float2" 0.1 0 ;
select -ne p1;
	setAttr ".re" -type "float2" 2 3 ;
	setAttr ".of" -type "float2" 0.25 0.5 ;
select -ne p2;
	setAttr ".rev" 2;
createNode multiplyDivide -n "half";
	setAttr ".i2" -type "float3" 0.5 0.5 0.5 ;
createNode exprespy -n "uvEx";
	setAttr ".cd" -type "string" "OUT[0] = [IN[0] * 0.5, IN[0]]";
createNode animCurveTL -n "texJ_translateX";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 24 1;
createNode animCurveTL -n "texJ_translateY";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 24 2;
createNode animCurveTU -n "p4_repeatU";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 1 24 4;
createNode script -n "sceneConfigurationScriptNode";
	setAttr ".b" -type "string" "playbackOptions -min 1 -max 24 -ast 1 -aet 24 ";
	setAttr ".st" 6;
connectAttr "p1.o" "f1.uv";
connectAttr "p1.re" "f1.re";
connectAttr "p1.of" "f1.of";
connectAttr "p1.ro" "f1.ro";
connectAttr "f1.oc" "m1.c";
connectAttr "m1.oc" "m1SG.ss";
connectAttr "q1Shape.iog" "m1SG.dsm" -na;
connectAttr "p2.o" "f2.uv";
connectAttr "p2.re" "f2.re";
connectAttr "p2.of" "f2.of";
connectAttr "p2.ro" "f2.ro";
connectAttr "f2.oc" "m2.c";
connectAttr "m2.oc" "m2SG.ss";
connectAttr "q2Shape.iog" "m2SG.dsm" -na;
connectAttr "p3.o" "f3.uv";
connectAttr "p3.re" "f3.re";
connectAttr "p3.of" "f3.of";
connectAttr "p3.ro" "f3.ro";
connectAttr "f3.oc" "m3.c";
connectAttr "m3.oc" "m3SG.ss";
connectAttr "q3Shape.iog" "m3SG.dsm" -na;
connectAttr "p4.o" "f4.uv";
connectAttr "p4.re" "f4.re";
connectAttr "p4.of" "f4.of";
connectAttr "p4.ro" "f4.ro";
connectAttr "f4.oc" "m4.c";
connectAttr "m4.oc" "m4SG.ss";
connectAttr "q4Shape.iog" "m4SG.dsm" -na;
connectAttr "p5.o" "f5.uv";
connectAttr "p5.re" "f5.re";
connectAttr "p5.of" "f5.of";
connectAttr "p5.ro" "f5.ro";
connectAttr "f5.oc" "m5.c";
connectAttr "m5.oc" "m5SG.ss";
connectAttr "q5Shape.iog" "m5SG.dsm" -na;
connectAttr "texJ_translateX.o" "texJ.tx";
connectAttr "texJ_translateY.o" "texJ.ty";
connectAttr "texJ.tx" "p2.offsetU";
connectAttr "texJ.ty" "half.i1y";
connectAttr "half.oy" "p2.ofv";
connectAttr "texJ.tx" "uvEx.i[0]";
connectAttr "uvEx.o[0]" "p3.of";
connectAttr "p4_repeatU.o" "p4.reu";
// End of place2d_sample.ma
