//Maya ASCII 2024 scene
//Name: rig_sample.ma
//Codeset: UTF-8
requires maya "2024";
currentUnit -l centimeter -a degree -t film;
fileInfo "application" "maya";
createNode joint -n "shoulder";
	rename -uid "00000000-0000-0000-0001-002946186525";
	setAttr ".t" -type "double3" 0 10 0 ;
createNode joint -n "elbow" -p "shoulder";
	rename -uid "00000000-0000-0000-0001-002170014498";
	setAttr ".t" -type "double3" 5 0 -1 ;
	setAttr ".pa" -type "double3" 0 0 0 ;
createNode joint -n "wrist" -p "elbow";
	rename -uid "00000000-0000-0000-0001-001486539882";
	setAttr ".t" -type "double3" 5 0 1 ;
createNode joint -n "hand_end" -p "wrist";
	rename -uid "00000000-0000-0000-0001-002037541318";
	setAttr ".t" -type "double3" 2 0 0 ;
createNode ikEffector -n "effector1" -p "elbow";
	rename -uid "00000000-0000-0000-0001-001672819530";
	setAttr ".t" -type "double3" 5 0 1 ;
	setAttr ".v" no;
	setAttr ".hd" yes;
createNode transform -n "hand_ctrl";
	rename -uid "00000000-0000-0000-0001-003426360255";
	setAttr ".t" -type "double3" 10 10 0 ;
createNode ikHandle -n "arm_ik" -p "hand_ctrl";
	rename -uid "00000000-0000-0000-0001-000831250590";
	setAttr ".roc" yes;
createNode poleVectorConstraint -n "arm_ik_poleVectorConstraint1" -p "arm_ik";
	rename -uid "00000000-0000-0000-0001-004055473475";
	addAttr -dcb 0 -ci true -k true -sn "w0" -ln "elbow_pvW0" -dv 1 -min 0 -at "double";
	setAttr -k on ".nds";
	setAttr -k on ".w0";
createNode transform -n "elbow_pv";
	rename -uid "00000000-0000-0000-0001-003895477693";
	setAttr ".t" -type "double3" 5 10 -10 ;
createNode orientConstraint -n "wrist_orientConstraint1" -p "wrist";
	rename -uid "00000000-0000-0000-0001-002989025282";
	addAttr -dcb 0 -ci true -k true -sn "w0" -ln "hand_ctrlW0" -dv 1 -min 0 -at "double";
	setAttr -k on ".nds";
	setAttr -k on ".w0";
createNode transform -n "prop";
	rename -uid "00000000-0000-0000-0001-002943272426";
	setAttr ".t" -type "double3" 12 10 0 ;
	setAttr ".r" -type "double3" 0 0 90 ;
createNode mesh -n "propShape" -p "prop";
	rename -uid "00000000-0000-0000-0001-001422940058";
	setAttr -k off ".v";
	setAttr ".vir" yes;
	setAttr ".vif" yes;
	setAttr -s 8 ".vt";
	setAttr ".vt[0:7]"  -0.5 -0.5 0.5
		 0.5 -0.5 0.5
		 -0.5 0.5 0.5
		 0.5 0.5 0.5
		 -0.5 0.5 -0.5
		 0.5 0.5 -0.5
		 -0.5 -0.5 -0.5
		 0.5 -0.5 -0.5;
	setAttr -s 12 ".ed";
	setAttr ".ed[0:11]"  0 1 0
		 1 3 0
		 3 2 0
		 2 0 0
		 3 5 0
		 5 4 0
		 4 2 0
		 5 7 0
		 7 6 0
		 6 4 0
		 7 1 0
		 0 6 0;
	setAttr -s 6 -ch 24 ".fc[0:5]" -type "polyFaces" 
		f 4 0 1 2 3
		f 4 -3 4 5 6
		f 4 -6 7 8 9
		f 4 -9 10 -1 11
		f 4 -11 -8 -5 -2
		f 4 -12 -4 -7 -10;
	setAttr ".cd" -type "dataPolyComponent" Index_Data Edge 0 ;
createNode parentConstraint -n "prop_parentConstraint1" -p "prop";
	rename -uid "00000000-0000-0000-0001-002100274252";
	addAttr -dcb 0 -ci true -k true -sn "w0" -ln "wristW0" -dv 1 -min 0 -at "double";
	setAttr -k on ".nds";
	setAttr -k on ".w0";
	setAttr ".tg[0].tot" -type "double3" 2 0 0 ;
	setAttr ".tg[0].tor" -type "double3" 0 0 90 ;
	setAttr ".rst" -type "double3" 12 10 0 ;
createNode transform -n "tgtA";
	rename -uid "00000000-0000-0000-0001-003255433350";
	setAttr ".t" -type "double3" -5 20 0 ;
createNode transform -n "tgtB";
	rename -uid "00000000-0000-0000-0001-001526769980";
	setAttr ".t" -type "double3" 5 20 0 ;
createNode joint -n "head";
	rename -uid "00000000-0000-0000-0001-002817783452";
	setAttr ".t" -type "double3" 0 20 0 ;
createNode pointConstraint -n "head_pointConstraint1" -p "head";
	rename -uid "00000000-0000-0000-0001-003666243553";
	addAttr -dcb 0 -ci true -k true -sn "w0" -ln "tgtAW0" -dv 1 -min 0 -at "double";
	addAttr -dcb 0 -ci true -k true -sn "w1" -ln "tgtBW1" -dv 1 -min 0 -at "double";
	setAttr -k on ".nds";
	setAttr -k on ".w0" 1;
	setAttr -k on ".w1";
createNode transform -n "scl_ctrl";
	rename -uid "00000000-0000-0000-0001-000464528959";
	setAttr ".t" -type "double3" 0 0 10 ;
	setAttr ".s" -type "double3" 2 2 2 ;
createNode joint -n "scl_jnt";
	rename -uid "00000000-0000-0000-0001-003900067966";
	setAttr ".t" -type "double3" 0 0 10 ;
	setAttr ".s" -type "double3" 2 2 2 ;
createNode scaleConstraint -n "scl_jnt_scaleConstraint1" -p "scl_jnt";
	rename -uid "00000000-0000-0000-0001-000489195106";
	addAttr -dcb 0 -ci true -k true -sn "w0" -ln "scl_ctrlW0" -dv 1 -min 0 -at "double";
	setAttr -k on ".nds";
	setAttr -k on ".w0";
createNode transform -n "ctrl_util";
	rename -uid "00000000-0000-0000-0001-003931966755";
	setAttr ".t" -type "double3" 2 0 0 ;
	addAttr -ci true -k true -sn "blend" -ln "blend" -dv 0 -at "double";
	setAttr -k on ".blend" 0.25;
createNode joint -n "util_jnt";
	rename -uid "00000000-0000-0000-0001-002427769461";
	setAttr ".t" -type "double3" 1 0 -10 ;
	setAttr ".r" -type "double3" 0 0 90 ;
	setAttr ".s" -type "double3" 1 1 1.5 ;
createNode joint -n "pb_jnt";
	rename -uid "00000000-0000-0000-0001-000589965889";
	setAttr ".t" -type "double3" 1 0 0 ;
	setAttr ".r" -type "double3" 0 0 45 ;
createNode multiplyDivide -n "md_scale";
	rename -uid "00000000-0000-0000-0001-002257152590";
	setAttr ".i2" -type "float3" 4 1 1 ;
createNode plusMinusAverage -n "pma_add";
	rename -uid "00000000-0000-0000-0001-004027185197";
	setAttr -s 2 ".i1";
	setAttr ".i1[1]" 1;
createNode reverse -n "rev";
	rename -uid "00000000-0000-0000-0001-000165162695";
createNode multiplyDivide -n "md_angle";
	rename -uid "00000000-0000-0000-0001-001783499459";
	setAttr ".i2" -type "float3" 90 1 1 ;
createNode unitConversion -n "uc_angle";
	rename -uid "00000000-0000-0000-0001-000012000979";
	setAttr ".cf" 0.017453292519943295;
createNode condition -n "cond";
	rename -uid "00000000-0000-0000-0001-004210944132";
	setAttr ".op" 2;
	setAttr ".st" 0.5;
	setAttr ".ct" -type "float3" 2 0 0 ;
	setAttr ".cf" -type "float3" 1 0 0 ;
createNode blendColors -n "bc";
	rename -uid "00000000-0000-0000-0001-003265866552";
	setAttr ".c1" -type "float3" 3 0 0 ;
	setAttr ".c2" -type "float3" 1 0 0 ;
createNode pairBlend -n "pb";
	rename -uid "00000000-0000-0000-0001-003445255037";
	setAttr ".w" 0.5;
	setAttr ".ir2" -type "double3" 0 0 90 ;
createNode joint -n "expr_jnt";
	rename -uid "00000000-0000-0000-0001-003500602266";
	setAttr ".t" -type "double3" 0 0 -20 ;
createNode expression -n "expression1";
	rename -uid "00000000-0000-0000-0001-004093898615";
	setAttr -k on ".nds";
	setAttr ".ixp" -type "string" ".O[0] = rand(360);";
createNode myCustomDriver -n "drv_key";
	rename -uid "00000000-0000-0000-0001-000877814626";
createNode animCurveTL -n "hand_ctrl_translateX";
	rename -uid "00000000-0000-0000-0001-002683951777";
	setAttr ".tan" 2;
	setAttr ".wgt" no;
	setAttr -s 3 ".ktv[0:2]"  1 10 24 7 48 10;
createNode animCurveTL -n "hand_ctrl_translateY";
	rename -uid "00000000-0000-0000-0001-003909020215";
	setAttr ".tan" 2;
	setAttr ".wgt" no;
	setAttr -s 3 ".ktv[0:2]"  1 10 24 13 48 10;
createNode animCurveTA -n "hand_ctrl_rotateZ";
	rename -uid "00000000-0000-0000-0001-003346947661";
	setAttr ".tan" 2;
	setAttr ".wgt" no;
	setAttr -s 2 ".ktv[0:1]"  1 0 48 30;
createNode animCurveTU -n "head_pointConstraint1_w1";
	rename -uid "00000000-0000-0000-0001-003886003364";
	setAttr ".tan" 2;
	setAttr ".wgt" no;
	setAttr -s 2 ".ktv[0:1]"  1 1 48 3;
createNode animCurveTL -n "ctrl_util_translateY";
	rename -uid "00000000-0000-0000-0001-000374931383";
	setAttr ".tan" 2;
	setAttr ".wgt" no;
	setAttr -s 2 ".ktv[0:1]"  1 0 48 1;
createNode script -n "sceneConfigurationScriptNode";
	rename -uid "00000000-0000-0000-0001-000086746734";
	setAttr ".b" -type "string" "playbackOptions -min 1 -max 48 -ast 1 -aet 48 ";
	setAttr ".st" 6;
createNode ikRPsolver -n "ikRPsolver";
	rename -uid "00000000-0000-0000-0001-000893454817";
select -ne :time1;
	setAttr ".o" 1;
	setAttr ".unw" 1;
connectAttr "shoulder.msg" "arm_ik.hsj";
connectAttr "effector1.hp" "arm_ik.hee";
connectAttr "ikRPsolver.msg" "arm_ik.hsv";
connectAttr "wrist.tx" "effector1.tx";
connectAttr "wrist.ty" "effector1.ty";
connectAttr "wrist.tz" "effector1.tz";
connectAttr "arm_ik_poleVectorConstraint1.ctx" "arm_ik.pvx";
connectAttr "arm_ik_poleVectorConstraint1.cty" "arm_ik.pvy";
connectAttr "arm_ik_poleVectorConstraint1.ctz" "arm_ik.pvz";
connectAttr "arm_ik.pim" "arm_ik_poleVectorConstraint1.cpim";
connectAttr "shoulder.pm" "arm_ik_poleVectorConstraint1.ps";
connectAttr "shoulder.t" "arm_ik_poleVectorConstraint1.crp";
connectAttr "elbow_pv.t" "arm_ik_poleVectorConstraint1.tg[0].tt";
connectAttr "elbow_pv.rp" "arm_ik_poleVectorConstraint1.tg[0].trp";
connectAttr "elbow_pv.rpt" "arm_ik_poleVectorConstraint1.tg[0].trt";
connectAttr "elbow_pv.pm" "arm_ik_poleVectorConstraint1.tg[0].tpm";
connectAttr "arm_ik_poleVectorConstraint1.w0" "arm_ik_poleVectorConstraint1.tg[0].tw";
connectAttr "wrist_orientConstraint1.crx" "wrist.rx";
connectAttr "wrist_orientConstraint1.cry" "wrist.ry";
connectAttr "wrist_orientConstraint1.crz" "wrist.rz";
connectAttr "wrist.ro" "wrist_orientConstraint1.cro";
connectAttr "wrist.pim" "wrist_orientConstraint1.cpim";
connectAttr "wrist.jo" "wrist_orientConstraint1.cjo";
connectAttr "wrist.is" "wrist_orientConstraint1.is";
connectAttr "hand_ctrl.r" "wrist_orientConstraint1.tg[0].tr";
connectAttr "hand_ctrl.ro" "wrist_orientConstraint1.tg[0].tro";
connectAttr "hand_ctrl.pm" "wrist_orientConstraint1.tg[0].tpm";
connectAttr "hand_ctrl.jo" "wrist_orientConstraint1.tg[0].tjo";
connectAttr "wrist_orientConstraint1.w0" "wrist_orientConstraint1.tg[0].tw";
connectAttr "prop_parentConstraint1.ctx" "prop.tx";
connectAttr "prop_parentConstraint1.crx" "prop.rx";
connectAttr "prop_parentConstraint1.cty" "prop.ty";
connectAttr "prop_parentConstraint1.cry" "prop.ry";
connectAttr "prop_parentConstraint1.ctz" "prop.tz";
connectAttr "prop_parentConstraint1.crz" "prop.rz";
connectAttr "prop.ro" "prop_parentConstraint1.cro";
connectAttr "prop.pim" "prop_parentConstraint1.cpim";
connectAttr "prop.rp" "prop_parentConstraint1.crp";
connectAttr "prop.rpt" "prop_parentConstraint1.crt";
connectAttr "wrist.t" "prop_parentConstraint1.tg[0].tt";
connectAttr "wrist.rp" "prop_parentConstraint1.tg[0].trp";
connectAttr "wrist.rpt" "prop_parentConstraint1.tg[0].trt";
connectAttr "wrist.r" "prop_parentConstraint1.tg[0].tr";
connectAttr "wrist.ro" "prop_parentConstraint1.tg[0].tro";
connectAttr "wrist.s" "prop_parentConstraint1.tg[0].ts";
connectAttr "wrist.pm" "prop_parentConstraint1.tg[0].tpm";
connectAttr "wrist.jo" "prop_parentConstraint1.tg[0].tjo";
connectAttr "wrist.ssc" "prop_parentConstraint1.tg[0].tsc";
connectAttr "wrist.is" "prop_parentConstraint1.tg[0].tis";
connectAttr "prop_parentConstraint1.w0" "prop_parentConstraint1.tg[0].tw";
connectAttr "head_pointConstraint1.ctx" "head.tx";
connectAttr "head_pointConstraint1.cty" "head.ty";
connectAttr "head_pointConstraint1.ctz" "head.tz";
connectAttr "head.pim" "head_pointConstraint1.cpim";
connectAttr "head.rp" "head_pointConstraint1.crp";
connectAttr "head.rpt" "head_pointConstraint1.crt";
connectAttr "tgtA.t" "head_pointConstraint1.tg[0].tt";
connectAttr "tgtA.rp" "head_pointConstraint1.tg[0].trp";
connectAttr "tgtA.rpt" "head_pointConstraint1.tg[0].trt";
connectAttr "tgtA.pm" "head_pointConstraint1.tg[0].tpm";
connectAttr "head_pointConstraint1.w0" "head_pointConstraint1.tg[0].tw";
connectAttr "tgtB.t" "head_pointConstraint1.tg[1].tt";
connectAttr "tgtB.rp" "head_pointConstraint1.tg[1].trp";
connectAttr "tgtB.rpt" "head_pointConstraint1.tg[1].trt";
connectAttr "tgtB.pm" "head_pointConstraint1.tg[1].tpm";
connectAttr "head_pointConstraint1.w1" "head_pointConstraint1.tg[1].tw";
connectAttr "head_pointConstraint1_w1.o" "head_pointConstraint1.w1";
connectAttr "scl_jnt_scaleConstraint1.csx" "scl_jnt.sx";
connectAttr "scl_jnt_scaleConstraint1.csy" "scl_jnt.sy";
connectAttr "scl_jnt_scaleConstraint1.csz" "scl_jnt.sz";
connectAttr "scl_jnt.pim" "scl_jnt_scaleConstraint1.cpim";
connectAttr "scl_ctrl.s" "scl_jnt_scaleConstraint1.tg[0].ts";
connectAttr "scl_ctrl.pm" "scl_jnt_scaleConstraint1.tg[0].tpm";
connectAttr "scl_jnt_scaleConstraint1.w0" "scl_jnt_scaleConstraint1.tg[0].tw";
connectAttr "ctrl_util.ty" "md_scale.i1x";
connectAttr "md_scale.ox" "pma_add.i1[0]";
connectAttr "pma_add.o1" "util_jnt.tx";
connectAttr "ctrl_util.ty" "rev.ix";
connectAttr "rev.ox" "md_angle.i1x";
connectAttr "md_angle.ox" "uc_angle.i";
connectAttr "uc_angle.o" "util_jnt.rz";
connectAttr "ctrl_util.ty" "cond.ft";
connectAttr "cond.ocr" "util_jnt.sy";
connectAttr "ctrl_util.blend" "bc.b";
connectAttr "bc.opr" "util_jnt.sz";
connectAttr "ctrl_util.t" "pb.it2";
connectAttr "pb.ot" "pb_jnt.t";
connectAttr "pb.or" "pb_jnt.r";
connectAttr "expression1.out[0]" "expr_jnt.ry";
connectAttr "ctrl_util.ty" "drv_key.i";
connectAttr "drv_key.o" "expr_jnt.rx";
connectAttr "hand_ctrl_translateX.o" "hand_ctrl.tx";
connectAttr "hand_ctrl_translateY.o" "hand_ctrl.ty";
connectAttr "hand_ctrl_rotateZ.o" "hand_ctrl.rz";
connectAttr "ctrl_util_translateY.o" "ctrl_util.ty";
// End of rig_sample.ma
