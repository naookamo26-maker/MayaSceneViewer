//Maya ASCII 2027 scene
//Name: dag_attrs_sample.ma
requires maya "2027";
currentUnit -l centimeter -a degree -t film;
createNode transform -n "ctrl";
createNode transform -n "piv";
	setAttr ".r" -type "double3" 0 0 90 ;
createNode joint -n "pivC" -p "piv";
	setAttr ".t" -type "double3" 1 0 0 ;
createNode joint -n "lim";
	setAttr ".mxtl" -type "double3" 2 1 1 ;
	setAttr ".xtxe" yes;
	setAttr ".mxrl" -type "double3" 45 45 45 ;
	setAttr ".xrze" yes;
createNode joint -n "limC" -p "lim";
	setAttr ".t" -type "double3" 1 0 0 ;
createNode transform -n "limS";
	setAttr ".r" -type "double3" 90 0 0 ;
	setAttr ".xrxl" 30;
	setAttr ".xrxe" yes;
createNode joint -n "limSC" -p "limS";
	setAttr ".t" -type "double3" 0 1 0 ;
createNode joint -n "jj";
createNode joint -n "jk" -p "jj";
	setAttr ".t" -type "double3" 1 0 0 ;
createNode joint -n "raJ";
createNode joint -n "raC" -p "raJ";
	setAttr ".t" -type "double3" 1 0 0 ;
createNode joint -n "roT";
	setAttr ".r" -type "double3" 90 0 90 ;
createNode joint -n "roC" -p "roT";
	setAttr ".t" -type "double3" 1 0 0 ;
createNode transform -n "shT";
createNode joint -n "shC" -p "shT";
	setAttr ".t" -type "double3" 0 1 0 ;
createNode joint -n "rd";
createNode animCurveTL -n "ctrl_translateX";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 24 4;
createNode animCurveTA -n "ctrl_rotateZ";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 24 90;
createNode animCurveTU -n "roT_rotateOrder";
	setAttr ".tan" 2;
	setAttr -s 2 ".ktv[0:1]"  1 0 24 2;
createNode script -n "sceneConfigurationScriptNode";
	setAttr ".b" -type "string" "playbackOptions -min 1 -max 24 -ast 1 -aet 24 ";
	setAttr ".st" 6;
connectAttr "ctrl_translateX.o" "ctrl.tx";
connectAttr "ctrl_rotateZ.o" "ctrl.rz";
connectAttr "roT_rotateOrder.o" "roT.ro";
connectAttr "ctrl.tx" "piv.rpx";
connectAttr "ctrl.tx" "lim.tx";
connectAttr "ctrl.rz" "lim.rz";
connectAttr "ctrl.rz" "jj.joz";
connectAttr "ctrl.rz" "raJ.raz";
connectAttr "ctrl.tx" "shT.shxy";
connectAttr "piv.rp" "rd.t";
// End of dag_attrs_sample.ma
